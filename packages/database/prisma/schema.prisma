// MarktMinder Prisma Schema
// Generated from existing PostgreSQL database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// USERS
// =====================================================
model User {
  id                      String    @id @default(uuid()) @db.Uuid
  email                   String    @unique @db.VarChar(255)
  passwordHash            String?   @map("password_hash") @db.VarChar(255)
  name                    String?   @db.VarChar(255)
  avatarUrl               String?   @map("avatar_url")
  emailVerified           Boolean   @default(false) @map("email_verified")
  emailVerificationToken  String?   @map("email_verification_token") @db.VarChar(255)
  passwordResetToken      String?   @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires    DateTime? @map("password_reset_expires") @db.Timestamptz
  role                    String    @default("user") @db.VarChar(20)
  
  // OAuth fields
  googleId                String?   @unique @map("google_id") @db.VarChar(255)
  appleId                 String?   @unique @map("apple_id") @db.VarChar(255)
  
  // Preferences
  notificationEmail       Boolean   @default(true) @map("notification_email")
  notificationPush        Boolean   @default(true) @map("notification_push")
  defaultCurrency         String    @default("EUR") @map("default_currency") @db.VarChar(3)
  timezone                String    @default("Europe/Berlin") @db.VarChar(50)
  
  // Telegram integration
  telegramChatId          String?   @map("telegram_chat_id") @db.VarChar(50)
  telegramUsername        String?   @map("telegram_username") @db.VarChar(255)
  telegramVerifiedAt      DateTime? @map("telegram_verified_at") @db.Timestamptz
  
  // Timestamps
  lastLoginAt             DateTime? @map("last_login_at") @db.Timestamptz
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  alerts                  Alert[]
  alertHistory            AlertHistory[]
  apiKeys                 ApiKey[]
  refreshTokens           RefreshToken[]
  subscription            Subscription?
  userProducts            UserProduct[]
  folders                 WatchlistFolder[]
  pushSubscriptions       PushSubscription[]
  billingHistory          BillingHistory[]

  conditionalAlerts       ConditionalAlert[]
  gamification            UserGamification?
  badges                  UserBadge[]
  telegramUser            TelegramUser?
  telegramLinkCode        TelegramLinkCode?

  @@map("users")
}

// =====================================================
// PRODUCTS
// =====================================================
model Product {
  id                  String       @id @default(uuid()) @db.Uuid
  
  // Marketplace identification
  marketplace         Marketplace
  marketplaceId       String       @map("marketplace_id") @db.VarChar(255)
  marketplaceRegion   String?      @map("marketplace_region") @db.VarChar(10)
  url                 String
  
  // Product details
  title               String?
  description         String?
  imageUrl            String?      @map("image_url")
  brand               String?      @db.VarChar(255)
  category            String?      @db.VarChar(255)
  
  // Current pricing
  currentPrice        Decimal?     @map("current_price") @db.Decimal(12, 2)
  currency            String       @default("EUR") @db.VarChar(3)
  availability        Availability?
  
  // Price statistics
  lowestPrice         Decimal?     @map("lowest_price") @db.Decimal(12, 2)
  highestPrice        Decimal?     @map("highest_price") @db.Decimal(12, 2)
  averagePrice        Decimal?     @map("average_price") @db.Decimal(12, 2)
  lowestPriceDate     DateTime?    @map("lowest_price_date") @db.Timestamptz
  highestPriceDate    DateTime?    @map("highest_price_date") @db.Timestamptz
  
  // Scraping metadata
  lastScrapedAt       DateTime?    @map("last_scraped_at") @db.Timestamptz
  scrapeFrequencyHours Int         @default(24) @map("scrape_frequency_hours")
  scrapePriority      Int          @default(5) @map("scrape_priority")
  scrapeErrorCount    Int          @default(0) @map("scrape_error_count")
  lastScrapeError     String?      @map("last_scrape_error")
  
  // Timestamps
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  alerts              Alert[]
  alertHistory        AlertHistory[]
  priceHistory        PriceHistory[]
  userProducts        UserProduct[]
  conditionalAlerts   ConditionalAlert[]

  @@unique([marketplace, marketplaceId, marketplaceRegion])
  @@index([marketplace])
  @@index([marketplaceId])
  @@index([lastScrapedAt])
  @@index([scrapePriority(sort: Desc), lastScrapedAt(sort: Asc)])
  @@map("products")
}

enum Marketplace {
  amazon
  etsy
  otto
}

enum Availability {
  in_stock
  out_of_stock
  limited
  unknown
}

// =====================================================
// PRICE HISTORY
// =====================================================
model PriceHistory {
  time          DateTime    @db.Timestamptz
  productId     String      @map("product_id") @db.Uuid
  price         Decimal     @db.Decimal(12, 2)
  currency      String      @default("EUR") @db.VarChar(3)
  availability  String?     @db.VarChar(50)
  sellerType    String?     @map("seller_type") @db.VarChar(50)
  sellerName    String?     @map("seller_name") @db.VarChar(255)
  shippingCost  Decimal?    @map("shipping_cost") @db.Decimal(10, 2)

  // Relations
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([time, productId])
  @@index([productId, time(sort: Desc)])
  @@map("price_history")
}

// =====================================================
// USER PRODUCTS (Join table)
// =====================================================
model UserProduct {
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String          @map("user_id") @db.Uuid
  productId           String          @map("product_id") @db.Uuid
  customName          String?         @map("custom_name") @db.VarChar(255)
  notes               String?
  folderId            String?         @map("folder_id") @db.Uuid
  isFavorite          Boolean         @default(false) @map("is_favorite")
  notifyOnAnyChange   Boolean         @default(false) @map("notify_on_any_change")
  addedAt             DateTime        @default(now()) @map("added_at") @db.Timestamptz

  // Relations
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product             Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  folder              WatchlistFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("user_products")
}

// =====================================================
// WATCHLIST FOLDERS
// =====================================================
model WatchlistFolder {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  name        String        @db.VarChar(255)
  color       String?       @db.VarChar(7)
  icon        String?       @db.VarChar(50)
  sortOrder   Int           @default(0) @map("sort_order")
  isPublic    Boolean       @default(false) @map("is_public")
  slug        String?       @unique @db.VarChar(255)
  description String?
  viewCount   Int           @default(0) @map("view_count")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    UserProduct[]

  @@unique([userId, name])
  @@index([slug])
  @@index([isPublic])
  @@map("watchlist_folders")
}

// =====================================================
// ALERTS
// =====================================================
model Alert {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @map("user_id") @db.Uuid
  productId           String        @map("product_id") @db.Uuid
  
  // Alert configuration
  alertType           AlertType     @map("alert_type")
  targetPrice         Decimal?      @map("target_price") @db.Decimal(12, 2)
  targetPercentage    Decimal?      @map("target_percentage") @db.Decimal(5, 2)
  
  // Alert status
  isActive            Boolean       @default(true) @map("is_active")
  isTriggered         Boolean       @default(false) @map("is_triggered")
  triggerCount        Int           @default(0) @map("trigger_count")
  lastTriggeredAt     DateTime?     @map("last_triggered_at") @db.Timestamptz
  lastTriggeredPrice  Decimal?      @map("last_triggered_price") @db.Decimal(12, 2)
  
  // Notification preferences
  notifyEmail         Boolean       @default(true) @map("notify_email")
  notifyPush          Boolean       @default(true) @map("notify_push")
  notifyOnce          Boolean       @default(false) @map("notify_once")
  
  // Timestamps
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product             Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  history             AlertHistory[]

  @@index([userId])
  @@index([productId])
  @@index([isActive])
  @@map("alerts")
}

enum AlertType {
  price_below
  price_above
  price_drop_pct
  price_rise_pct
  any_change
  back_in_stock
  all_time_low
}

// =====================================================
// ALERT HISTORY
// =====================================================
model AlertHistory {
  id          String    @id @default(uuid()) @db.Uuid
  alertId     String    @map("alert_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  triggeredAt DateTime  @default(now()) @map("triggered_at") @db.Timestamptz
  oldPrice    Decimal?  @map("old_price") @db.Decimal(12, 2)
  newPrice    Decimal?  @map("new_price") @db.Decimal(12, 2)
  emailSent   Boolean   @default(false) @map("email_sent")
  pushSent    Boolean   @default(false) @map("push_sent")
  clicked     Boolean   @default(false)
  clickedAt   DateTime? @map("clicked_at") @db.Timestamptz

  // Relations
  alert       Alert     @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, triggeredAt(sort: Desc)])
  @@map("alert_history")
}

// =====================================================
// SUBSCRIPTIONS
// =====================================================
model Subscription {
  id                    String            @id @default(uuid()) @db.Uuid
  userId                String            @unique @map("user_id") @db.Uuid
  tier                  SubscriptionTier  @default(free)
  status                SubscriptionStatus @default(active)
  stripeCustomerId      String?           @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId  String?           @map("stripe_subscription_id") @db.VarChar(255)
  currentPeriodStart    DateTime          @default(now()) @map("current_period_start") @db.Timestamptz
  currentPeriodEnd      DateTime          @default(dbgenerated("NOW() + INTERVAL '100 years'")) @map("current_period_end") @db.Timestamptz
  cancelAtPeriodEnd     Boolean           @default(false) @map("cancel_at_period_end")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

enum SubscriptionTier {
  free
  pro
  power
  business
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  trialing
  incomplete
}

// =====================================================
// REFRESH TOKENS
// =====================================================
model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @map("token_hash") @db.VarChar(255)
  deviceInfo  String?   @map("device_info")
  ipAddress   String?   @map("ip_address") @db.Inet
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// =====================================================
// API KEYS
// =====================================================
model ApiKey {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  name        String        @db.VarChar(255)
  keyHash     String        @map("key_hash") @db.VarChar(255)
  keyPrefix   String        @map("key_prefix") @db.VarChar(20)
  permissions Json          @default("[\"read\"]")
  rateLimit   Int           @default(100) @map("rate_limit")
  lastUsedAt  DateTime?     @map("last_used_at") @db.Timestamptz
  expiresAt   DateTime?     @map("expires_at") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz

  // Relations
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageLogs   ApiUsageLog[]

  @@index([userId])
  @@index([keyPrefix])
  @@map("api_keys")
}

// =====================================================
// API USAGE LOGS
// =====================================================
model ApiUsageLog {
  id              String   @id @default(uuid()) @db.Uuid
  apiKeyId        String   @map("api_key_id") @db.Uuid
  endpoint        String   @db.VarChar(255)
  responseTimeMs  Int?     @map("response_time_ms")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  apiKey          ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("api_usage_logs")
}

// =====================================================
// BILLING HISTORY
// =====================================================
model BillingHistory {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  stripeInvoiceId String?  @map("stripe_invoice_id") @db.VarChar(255)
  amountCents     Int      @map("amount_cents")
  currency        String   @default("EUR") @db.VarChar(3)
  status          BillingStatus
  description     String?
  invoiceUrl      String?  @map("invoice_url")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("billing_history")
}

enum BillingStatus {
  paid
  pending
  failed
  refunded
}

// =====================================================
// PUSH SUBSCRIPTIONS
// =====================================================
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// =====================================================
// CONDITIONAL ALERTS
// =====================================================
model ConditionalAlert {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  name            String   @db.VarChar(255)
  conditions      Json
  logic           String   @default("AND") @db.VarChar(10)
  isActive        Boolean  @default(true) @map("is_active")
  notifyVia       Json     @map("notify_via")
  cooldownHours   Int      @default(24) @map("cooldown_hours")
  lastTriggeredAt DateTime? @map("last_triggered_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("conditional_alerts")
  @@index([userId])
  @@index([productId])
}

// =====================================================
// GAMIFICATION
// =====================================================
model UserGamification {
  userId        String   @id @map("user_id") @db.Uuid
  totalSaved    Decimal  @default(0) @map("total_saved") @db.Decimal(12, 2)
  dealsFound    Int      @default(0) @map("deals_found")
  currentStreak Int      @default(0) @map("current_streak")
  bestStreak    Int      @default(0) @map("best_streak")
  lastDealAt    DateTime? @map("last_deal_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_gamification")
}

model UserBadge {
  userId      String   @map("user_id") @db.Uuid
  badgeId     String   @map("badge_id") @db.VarChar(50)
  unlockedAt  DateTime @default(now()) @map("unlocked_at") @db.Timestamptz

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@map("user_badges")
}

// =====================================================
// TELEGRAM
// =====================================================
model TelegramUser {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  telegramChatId      String   @unique @map("telegram_chat_id") @db.VarChar(50)
  telegramUsername    String?  @map("telegram_username") @db.VarChar(255)
  isVerified          Boolean  @default(false) @map("is_verified")
  notificationsEnabled Boolean @default(true) @map("notifications_enabled")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_users")
}

model TelegramLinkCode {
  userId    String   @id @map("user_id") @db.Uuid
  code      String   @map("code") @db.VarChar(10)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_link_codes")
}
