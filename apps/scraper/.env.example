# ==============================================
# MarktMinder Scraper - Environment Configuration
# ==============================================

# Node Environment
NODE_ENV=development

# ==============================================
# Database Configuration
# ==============================================

# PostgreSQL Connection String
# Format: postgresql://username:password@host:port/database
# Must match backend database for data synchronization
DATABASE_URL=postgresql://marktminder:marktminder@localhost:5432/marktminder

# ==============================================
# Redis Configuration
# ==============================================

# Redis Connection URL for job queue (BullMQ)
# Format: redis://[username]:[password]@host:port/db
REDIS_URL=redis://localhost:6379

# ==============================================
# Scraping Configuration
# ==============================================

# Number of concurrent scraping jobs
# Recommended: 2-5 to avoid rate limiting
SCRAPE_CONCURRENCY=3

# Delay between requests to same domain (milliseconds)
# Higher values reduce detection risk
SCRAPE_DELAY_MS=2000

# Request timeout (milliseconds)
SCRAPE_TIMEOUT_MS=30000

# Number of retry attempts on failure
SCRAPE_RETRY_ATTEMPTS=3

# User Agent for HTTP requests
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# ==============================================
# Proxy Configuration (Optional)
# ==============================================

# Enable proxy for scraping requests
PROXY_ENABLED=false

# Proxy server details (if enabled)
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# ==============================================
# Rate Limiting (per minute)
# ==============================================

# Amazon: Conservative to avoid blocking
RATE_LIMIT_AMAZON=20

# Etsy: More permissive API
RATE_LIMIT_ETSY=30

# Otto: Moderate limits
RATE_LIMIT_OTTO=25

# ==============================================
# API Keys (Optional)
# ==============================================

# Etsy Official API (alternative to scraping)
# Get from: https://www.etsy.com/developers/
ETSY_API_KEY=your_etsy_api_key
ETSY_API_SECRET=your_etsy_api_secret

# ScraperAPI (for anti-bot protection bypass)
# Get from: https://www.scraperapi.com/
SCRAPER_API_KEY=your_scraper_api_key

# ==============================================
# Logging
# ==============================================

# Log Level: error, warn, info, debug, verbose
LOG_LEVEL=info

# ==============================================
# Error Monitoring
# ==============================================

# Sentry DSN for scraper error tracking (optional)
SENTRY_DSN=

# ==============================================
# Job Queue Configuration
# ==============================================

# Job retry settings
JOB_MAX_RETRIES=3
JOB_BACKOFF_DELAY=5000

# Job cleanup (remove completed jobs after N days)
JOB_CLEANUP_DAYS=7
